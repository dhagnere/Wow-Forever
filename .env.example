# --- Site ---
# Adresse publique, sans barre finale. Sert aux liens Facebook, au plan du site et aux balises Open Graph.
SITE_URL=https://azeroth-forever.fr

# --- Base de données ---
# Fournie automatiquement par l'extension PostgreSQL de Scalingo (SCALINGO_POSTGRESQL_URL est aussi lue).
DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/azeroth_forever

# --- Espace d'administration /admin/veille ---
# Mot de passe de connexion (16 caractères minimum).
ADMIN_PASSWORD=
# Secret de signature des sessions : 32 caractères aléatoires minimum (openssl rand -hex 32).
SESSION_SECRET=

# --- Rédaction par IA (API Anthropic) ---
ANTHROPIC_API_KEY=
# Facultatif : modèle utilisé pour la rédaction (par défaut claude-opus-5-5).
ANTHROPIC_MODEL=
# Facultatif : nombre de brouillons rédigés chaque matin (par défaut 12).
VEILLE_BROUILLONS_PAR_JOUR=12

# --- Relais Facebook (API Pages de Meta) ---
# Identifiant numérique de la Page et jeton de Page longue durée avec la permission pages_manage_posts.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Facultatif : version de l'API Graph (par défaut v21.0).
FACEBOOK_GRAPH_VERSION=
# Reels : une vidéo verticale par article, publiée après le post. « off » les coupe.
FACEBOOK_REELS=

# --- Google Search Console ---
# Méthode « Balise HTML » : coller uniquement la valeur de content="…" (ex. AbCdEf123…), sans la balise.
GOOGLE_SITE_VERIFICATION=

# --- Mesure d'audience ---
# Conteneur Google Tag Manager (par défaut GTM-KMGBD5FD). « off » le désactive, par exemple en local.
NEXT_PUBLIC_GTM_ID=

# --- Instagram (compte professionnel relié à la Page Facebook) ---
# Par défaut, le jeton de Page ci-dessus est utilisé : il doit avoir instagram_basic et instagram_content_publish.
INSTAGRAM_TOKEN=
# Facultatif : retrouvé automatiquement depuis la Page.
INSTAGRAM_USER_ID=
# « off » coupe la publication sur Instagram.
INSTAGRAM_PUBLICATION=

# --- TikTok (application développeur, compte relié depuis /admin/reseaux/) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# « brouillon » (par défaut : vidéo envoyée dans la boîte de réception TikTok) ou « direct » (application auditée par TikTok).
TIKTOK_MODE=
# « off » coupe la publication sur TikTok.
TIKTOK_PUBLICATION=

# --- Liens publics (facultatifs) ---
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/azerothforever
